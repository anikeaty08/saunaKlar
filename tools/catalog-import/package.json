    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@saunaklar/db": "*",
    "@saunaklar/pricing": "*",
    "pg": "^8.16.3",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@types/pg": "^8.15.5"
  }
}
