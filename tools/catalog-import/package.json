{
  "name": "@saunaklar/catalog-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catalog import pipeline: YAML manifests -> validate -> optimise -> upload -> one DB transaction per sauna.",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "catalog-import": "./bin/catalog-import.mjs"
  },
  "scripts": {
