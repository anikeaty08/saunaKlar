# services/api environment. Local defaults work without any of these set.
# In AWS, secrets come from Secrets Manager / SSM via the deployment, never from a file.

# ---- Core (src/config.ts) ----------------------------------------------------
NODE_ENV=development
PORT=8787
# Login URL of the API's own DB user (per-function IAM users in AWS, DB_IAM_AUTH=1).
API_DATABASE_URL=postgres://sauna_api:sauna_api@127.0.0.1:5432/sauna
DATABASE_POOL_MAX=10
DB_IAM_AUTH=0
PLATFORM_DOMAIN=localhost
ADMIN_HOST=admin.localhost
PUBLIC_SCHEME=http
PUBLIC_PORT=5173
# CSRF tokens and cursor signing; 32+ random bytes in production.
APP_SECRET=dev-only-secret-change-me-0123456789
# Secret header CloudFront adds as x-origin-secret; empty disables the check locally.
ORIGIN_SECRET=
COOKIE_SECURE=true
TRUST_X_TENANT_HOST=true
SHARE_PRICE_VALID_DAYS=30
ASSET_COOKIE_TTL_SECONDS=600
AR_URL_TTL_SECONDS=300
RATE_LIMIT=true
LOG_LEVEL=info

# ---- Adapters (src/adapters/index.ts) -------------------------------------------
# local = Postgres idp/devtools schemas, filesystem, HMAC edge; aws = Cognito, SES, S3, CloudFront, SQS.
ADAPTERS=local
AWS_REGION=eu-central-1
# TOTP policy of the staff pool (local IdP; the Cognito staff pool enforces it itself).
STAFF_MFA=REQUIRED
TOTP_ISSUER=Saunaklar
# Platform mail domain: From is always no-reply@<domain>; resellers only appear as display name and Reply-To.
MAIL_FROM_DOMAIN=mail.localhost
MAIL_DEFAULT_FROM_NAME=Saunaklar
# Asset bucket: staging uploads/<slug>/<random> (never served) and branding/<slug>/<random>/<name>.
# Required with ADAPTERS=aws; locally the directory name under LOCAL_OBJECTS_DIR (default assets).
S3_ASSETS_BUCKET=

# local only (dev defaults are used when empty; mandatory when NODE_ENV=production)
LOCAL_IDP_JWT_SECRET=
LOCAL_ASSET_SIGNING_SECRET=
LOCAL_UPLOAD_SIGNING_SECRET=
LOCAL_OBJECTS_DIR=var/objects
LOCAL_ASSET_URL_SCHEME=http

# aws only
COGNITO_CUSTOMER_POOL_ID=
COGNITO_CUSTOMER_CLIENT_ID=
COGNITO_STAFF_POOL_ID=
COGNITO_STAFF_CLIENT_ID=
SES_CONFIGURATION_SET=
CLOUDFRONT_KEY_PAIR_ID=
# Secrets Manager secret holding the PEM private key of the active CloudFront public key.
CLOUDFRONT_PRIVATE_KEY_SECRET_ARN=
# Alternative to the ARN for ad-hoc runs: the PEM inline.
CLOUDFRONT_PRIVATE_KEY=
EDGE_TENANT_KVS_ARN=
SQS_QUEUE_URL=
